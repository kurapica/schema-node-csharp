<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="using:SchemaNode.Avalonia.View"
             xmlns:loc="using:SchemaNode.Avalonia.View.Localization"
             x:Class="SchemaNode.Avalonia.Man.Views.FunctionDefinitionView"
             x:CompileBindings="False">
  <Grid Margin="8" ColumnDefinitions="3*,2*">
    <!-- Left: property area of the definition node. return / args / exps under function are real
         Core fields; the view does no secondary modeling. -->
    <DockPanel Grid.Column="0" Margin="0,0,8,0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.function.label.header}"
                   FontSize="14" Margin="0,0,0,8" />

        <WrapPanel Margin="0,0,0,4">
          <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.label.namespace}" VerticalAlignment="Center" />
          <TextBox Width="140" Margin="4,0"
                   Text="{Binding Namespace, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.refresh}"
                  Command="{Binding LoadListCommand}" Margin="4,0" />
          <ComboBox Width="240" Margin="4,0"
                    ItemsSource="{Binding Functions}"
                    SelectedItem="{Binding SelectedFunction, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </WrapPanel>

        <WrapPanel Margin="0,0,0,4">
          <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.function.label.fullname}" VerticalAlignment="Center" />
          <TextBox Width="240" Margin="4,0"
                   Text="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.function.button.new}"
                  Command="{Binding NewCommand}" Margin="4,0" />
          <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.save}"
                  Command="{Binding SaveCommand}" Margin="4,0" />
        </WrapPanel>

        <TextBlock Text="{Binding Status}" Foreground="Gray"
                   TextWrapping="Wrap" Margin="0,0,0,6" />
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
        <view:SchemaView Node="{Binding Editor.Node}" Registry="{Binding Editor.Registry}" />
      </ScrollViewer>
    </DockPanel>

    <!-- Right: test area. Argument inputs create nodes from the parameter types resolved by
         FunctionType; the result creates a node from the return type. -->
    <DockPanel Grid.Column="1">
      <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"
                 Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.function.label.test}" />

      <Grid RowDefinitions="*,Auto,*">
        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                     Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.function.label.args}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ArgInputs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                          Padding="0,4" Margin="0,0,0,4">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TypeName}" Foreground="Gray" VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- Type resolved: hand the node to SchemaView and let it wrap. -->
                      <view:SchemaView Node="{Binding Node}" IsVisible="{Binding HasNode}" />

                      <!-- Generic or unresolvable type: JSON text. -->
                      <TextBox Margin="0,2,0,0"
                               Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               IsVisible="{Binding HasTextInput}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <Button Grid.Row="1" HorizontalAlignment="Left" Margin="0,8" Padding="12,2"
                Command="{Binding CallCommand}"
                Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.call}" />

        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                     Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.function.label.result}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <!-- Structured result: node created from the return type, reusing the same rendering. -->
              <view:SchemaView Node="{Binding ResultNode}" IsVisible="{Binding HasResult}" />

              <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="Consolas" Height="120" Margin="0,4,0,0"
                       IsVisible="{Binding HasResultText}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
