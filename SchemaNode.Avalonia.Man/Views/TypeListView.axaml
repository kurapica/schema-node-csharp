<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="using:SchemaNode.Avalonia.View"
             xmlns:loc="using:SchemaNode.Avalonia.View.Localization"
             xmlns:inf="using:SchemaNode.Avalonia.Man.Infrastructure"
             x:Class="SchemaNode.Avalonia.Man.Views.TypeListView"
             x:CompileBindings="False">
  <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto">
    <!-- Namespace selector. It is a SchemaView over a system.schema.namespace.type node, so the
         child namespaces come from the Core entry source and the selector drills down level by
         level instead of a free-text box + load button. -->
    <Border Grid.Row="0" Background="#F5F5F5" Padding="8" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.label.namespace}"
                   VerticalAlignment="Center" />
        <view:SchemaView Node="{Binding NamespaceWrapper}" VerticalAlignment="Center" />
        <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.up}"
                Command="{Binding UpCommand}" VerticalAlignment="Center" />

        <!-- Node kind filter: a system.schema.node.kind node; empty means "all kinds". The
             optional filter can be cleared from the editor, and the placeholder below marks the
             unfiltered state. -->
        <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.label.kind}"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
        <Grid VerticalAlignment="Center">
          <view:SchemaView Node="{Binding KindWrapper}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.kind.all}"
                     VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"
                     IsHitTestVisible="False"
                     IsVisible="{Binding IsKindFilterEmpty}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- List-level actions only: row creation is a list concern; field editing lives on the document screen. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
      <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.new}"
              Command="{Binding NewCommand}" />
      <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.refresh}"
              Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding Status}" Foreground="DarkSlateGray" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxWidth="640"
                 IsVisible="{Binding Status, Converter={x:Static inf:Converters.VisibleIfText}}" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="1,1,1,0" Padding="6,4">
          <Grid ColumnDefinitions="260,360,220,*">
            <TextBlock Grid.Column="0" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.name}" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.display}" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.kind}" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.actions}" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,0,1,1">
          <ListBox ItemsSource="{Binding Schemas}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="260,360,220,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayText}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- View / edit open the document route (the vue el-drawer equivalent). Edit is
                         driven by the row's IsEditable (Man's own rule), so a namespace row shows
                         it next to "Next level"; the two actions are independent. -->
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.view}"
                            Command="{Binding $parent[ListBox].DataContext.ViewCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsType}" Padding="6,2" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.copy}"
                            Command="{Binding $parent[ListBox].DataContext.CopyCommand}"
                            CommandParameter="{Binding}"
                            Padding="6,2" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.edit}"
                            Command="{Binding $parent[ListBox].DataContext.EditCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsEditable}" Padding="6,2" />
                    <!-- Namespaces: drill down. Only shown when kind = namespace. -->
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.enter}"
                            Command="{Binding $parent[ListBox].DataContext.EnterCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsNamespace}" Padding="6,2" />
                    <!-- Delete: hidden for system-defined, referenced or delete-forbidden schemas. -->
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.delete}"
                            Command="{Binding $parent[ListBox].DataContext.DeleteCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanDelete}" Padding="6,2" />
                    <!-- Demo collapsed into the row (struct / array only). -->
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.demo}"
                            Command="{Binding $parent[ListBox].DataContext.DemoCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsDemoable}"
                            Background="#1976D2" Foreground="White" BorderBrush="#1565C0" Padding="6,2" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>

      <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.status.empty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                 IsHitTestVisible="False"
                 IsVisible="{Binding IsEmpty}" />
    </Grid>

    <TextBlock Grid.Row="3"
               Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.status.hint}"
               Foreground="Gray" Margin="0,8,0,0" />
  </Grid>
</UserControl>
