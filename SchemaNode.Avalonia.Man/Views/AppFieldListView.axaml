<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SchemaNode.Avalonia.View.Localization"
             xmlns:inf="using:SchemaNode.Avalonia.Man.Infrastructure"
             x:Class="SchemaNode.Avalonia.Man.Views.AppFieldListView"
             x:CompileBindings="False">
  <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Spacing="4">
      <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.button.back}"
              Command="{Binding BackCommand}" Margin="0,0,12,0" />
      <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.label.app}"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding AppFullName}" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
      <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.button.new}"
              Command="{Binding NewCommand}" />
      <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.refresh}"
              Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding Status}" Foreground="DarkSlateGray" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxWidth="640"
                 IsVisible="{Binding Status, Converter={x:Static inf:Converters.VisibleIfText}}" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,*">
        <Border Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="1,1,1,0" Padding="6,4">
          <Grid ColumnDefinitions="200,220,60,280,*">
            <TextBlock Grid.Column="0" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.name}" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.label.type}" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.column.seqno}" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.display}" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold"
                       Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.column.actions}" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="0,0,1,1">
          <ListBox ItemsSource="{Binding Fields}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="200,220,60,280,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding TypeText}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Seqno}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />

                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.view}"
                            Command="{Binding $parent[ListBox].DataContext.ViewCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding CanView}" Padding="6,2" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.type.button.edit}"
                            Command="{Binding $parent[ListBox].DataContext.EditCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding CanEdit}" Padding="6,2" />
                    <!-- Try-it (demo) is visually distinguished from structural actions. -->
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.button.demo}"
                            Command="{Binding $parent[ListBox].DataContext.DemoCommand}"
                            CommandParameter="{Binding}"
                            Background="#1976D2" Foreground="White" Padding="6,2" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.button.moveup}"
                            Command="{Binding $parent[ListBox].DataContext.MoveUpCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding CanMoveUp}" Padding="6,2" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.button.delete}"
                            Command="{Binding $parent[ListBox].DataContext.DeleteCommand}"
                            CommandParameter="{Binding}" IsVisible="{Binding CanDelete}" Padding="6,2" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </Grid>

      <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.status.empty}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                 IsHitTestVisible="False" IsVisible="{Binding IsEmpty}" />
    </Grid>

    <TextBlock Grid.Row="3"
               Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.appfieldlist.hint}"
               Foreground="Gray" Margin="0,8,0,0" TextWrapping="Wrap" />
  </Grid>
</UserControl>
