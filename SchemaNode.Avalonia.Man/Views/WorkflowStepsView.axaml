<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SchemaNode.Avalonia.View.Localization"
             x:Class="SchemaNode.Avalonia.Man.Views.WorkflowStepsView"
             x:CompileBindings="False">
  <!-- The workflow steps are a DAG, not tabular data. Show an ordered summary here and let the
       user add/remove steps inline (aligned with workflownodesView.vue in schema-node-man); the
       dedicated workflow canvas still offers graph editing for saved definitions. -->
  <Border Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="10">
    <StackPanel>
      <DockPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0"
                Command="{Binding AddNodeCommand}"
                IsVisible="{Binding IsEditable}"
                Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.workflow.steps.add}" />
      </DockPanel>

      <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,4" Padding="8,4" Background="White"
                    BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="3">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Type}" Foreground="#667085" Margin="12,0,0,0"
                             VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding HasPrevious}">
                    <TextBlock Foreground="#8A8F98"
                               Text="{Binding $parent[UserControl].DataContext.PreviousLabel}" />
                    <TextBlock Text="{Binding PreviousText}" Foreground="#8A8F98" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center"
                            IsVisible="{Binding $parent[UserControl].DataContext.IsEditable}">
                  <Button Padding="4,1" Margin="2,0"
                          Command="{Binding $parent[UserControl].DataContext.AddChildCommand}"
                          CommandParameter="{Binding}"
                          Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.workflow.steps.addchild}" />
                  <Button Padding="4,1" Margin="2,0"
                          Command="{Binding $parent[UserControl].DataContext.DeleteCommand}"
                          CommandParameter="{Binding}"
                          Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.workflow.steps.delete}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button HorizontalAlignment="Center" Margin="0,6,0,0" Padding="12,4"
              Command="{Binding AddNodeCommand}"
              IsVisible="{Binding ShowEmptyAdd}"
              Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=avalonia.workflow.steps.addfirst}" />

      <TextBlock Text="{Binding EmptyText}" Foreground="#8A8F98" Margin="0,4,0,0"
                 IsVisible="{Binding IsEmpty}" />

      <TextBlock Text="{Binding Message}" Foreground="#E74C3C" Margin="0,4,0,0"
                 IsVisible="{Binding HasMessage}" />
    </StackPanel>
  </Border>
</UserControl>
