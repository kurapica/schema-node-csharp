<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SchemaNode.WPF.AppView.Views">
    <!-- Dedicated view key: a host merges this dictionary so the registry can resolve a bound
         array node to the pageable surface without hard-coding a node kind. -->
    <DataTemplate x:Key="SchemaPageTable">
        <views:PageTableView />
    </DataTemplate>
</ResourceDictionary>
