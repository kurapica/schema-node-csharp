<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SchemaNode.Avalonia.View.Views"
             x:Class="SchemaNode.Avalonia.View.Views.TypeSelectorView"
             x:CompileBindings="False">
  <!--
      Counterpart of schema-node-man/src/view/namespace.vue: the path editor (namespace / type
      cascade, namespace.vue delegates it to input-view) followed by the generic arguments.
      The path editor is the shared InputView, so the cascade popup, path formatting and commit
      rules live in CascaderView / InputWrapper and are not duplicated here.
  -->
  <Grid ColumnDefinitions="*,Auto">
    <views:InputView x:Name="MainInput"
                     Grid.Column="0"
                     DataContext="{Binding Main}" />

    <Grid Grid.Column="1"
          Margin="2,0,0,0"
          VerticalAlignment="Center"
          ColumnDefinitions="Auto,*,Auto"
          IsVisible="{Binding HasGenerics}">
      <TextBlock Grid.Column="0" Text="&lt;" VerticalAlignment="Center" />

      <ItemsControl Grid.Column="1" ItemsSource="{Binding Arguments}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="1,0" ColumnDefinitions="*,Auto">
              <views:TypeSelectorView Grid.Column="0"
                                      DataContext="{Binding Wrapper}"
                                      MinWidth="0"
                                      InputMinWidth="0" />
              <TextBlock Grid.Column="1"
                         Text=","
                         VerticalAlignment="Center"
                         IsVisible="{Binding ShowComma}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Column="2" Text="&gt;" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
