<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SchemaNode.Avalonia.View.Views"
             x:Class="SchemaNode.Avalonia.View.Views.TableView"
             x:CompileBindings="False">
  <DockPanel>
    <!-- Header area: two header rows sharing the body's horizontal offset. The hidden horizontal
         scrollbar keeps the header width identical to the body viewport. -->
    <ScrollViewer x:Name="HeaderScroll"
                  DockPanel.Dock="Top"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Background="#FFF5F5F5">
        <!-- The group row has no interactive content, so it can stay excluded from hit testing;
             the leaf row hosts the inline command buttons and must remain hit-testable. -->
        <ItemsControl ItemsSource="{Binding TopHeaders}"
                      IsVisible="{Binding HasGroupHeaders}"
                      IsHitTestVisible="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="{Binding Width}"
                      MinHeight="26"
                      Background="#FFF5F5F5"
                      BorderBrush="#FFD0D0D0"
                      BorderThickness="0,0,1,1">
                <TextBlock Margin="4,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Label}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding LeafHeaders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="{Binding Width}"
                      MinHeight="26"
                      Background="#FFF5F5F5"
                      BorderBrush="#FFD0D0D0"
                      BorderThickness="0,0,1,1">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <TextBlock Margin="4,0"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Label}" />
                  <Button Margin="4,0"
                          MinWidth="18"
                          MinHeight="18"
                          Padding="2,0"
                          FontSize="12"
                          Content="{Binding CommandText}"
                          Command="{Binding Command}"
                          IsVisible="{Binding HasCommand}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Body: rows own the vertical and horizontal scrolling; the host never scrolls sideways. -->
    <ScrollViewer x:Name="BodyScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding RowGroups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:TableRowGroupView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
