<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SchemaNode.Avalonia.View.Views.LanguageView"
             x:CompileBindings="False"
             MinHeight="24"
             ToolTip.Tip="{Binding ErrorTip}">
  <Grid RowDefinitions="Auto,Auto">
    <!-- Closed choice: a language is one of the configured locale codes. Nothing is selected
         until the user picks one, so the node stays empty instead of receiving a default. -->
    <ComboBox Grid.Row="0"
              ItemsSource="{Binding Languages}"
              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
              IsEnabled="{Binding IsEditable}"
              MaxDropDownHeight="240"
              MinHeight="24" />

    <TextBlock Grid.Row="1"
               Margin="0,2,0,0"
               Foreground="#FFC62828"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding ShowError}" />
  </Grid>
</UserControl>
