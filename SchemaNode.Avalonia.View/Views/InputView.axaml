<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SchemaNode.Avalonia.View"
             xmlns:views="using:SchemaNode.Avalonia.View.Views"
             x:Class="SchemaNode.Avalonia.View.Views.InputView"
             x:CompileBindings="False"
             MinHeight="24"
             ToolTip.Tip="{Binding ErrorTip}">
  <Grid RowDefinitions="Auto,Auto">
    <!-- Plain text: no entries at all -->
    <TextBox Grid.Row="0"
             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
             IsEnabled="{Binding IsEditable}"
             IsReadOnly="{Binding IsEditable, Converter={x:Static local:Converters.Not}}"
             IsVisible="{Binding IsPlainText}"
             MinHeight="24" />

    <!-- Single level entry source: compact closed drop-down. Optional selectors get an explicit
         clear button so a chosen value can return to "unselected". -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          IsVisible="{Binding IsDropDown}">
      <ComboBox Grid.Column="0"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                IsEnabled="{Binding IsEditable}"
                MinHeight="24"
                MaxDropDownHeight="240">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
      </ComboBox>
      <Button Grid.Column="1"
              Width="24"
              MinHeight="24"
              Margin="2,0,0,0"
              Padding="0"
              Content="&#10005;"
              IsEnabled="{Binding IsEditable}"
              IsVisible="{Binding CanClear}"
              Click="OnClearClick" />
    </Grid>

    <!-- Suggestion mode: free text plus a candidate drop-down. Avalonia does not ship an
         editable combo box, so the two halves are separate controls sharing one value. -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto,Auto"
          IsVisible="{Binding IsSuggest}">
      <TextBox Grid.Column="0"
               Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
               IsEnabled="{Binding IsEditable}"
               MinHeight="24" />
      <ToggleButton Grid.Column="1"
                    x:Name="SuggestToggle"
                    Width="24"
                    MinHeight="24"
                    Padding="0"
                    Content="&#9662;"
                    IsEnabled="{Binding IsEditable}"
                    IsChecked="{Binding IsSuggestOpen, Mode=TwoWay}" />
      <Button Grid.Column="2"
              Width="24"
              MinHeight="24"
              Margin="2,0,0,0"
              Padding="0"
              Content="&#10005;"
              IsEnabled="{Binding IsEditable}"
              IsVisible="{Binding CanClear}"
              Click="OnClearClick" />
      <Popup Grid.ColumnSpan="3"
             x:Name="SuggestPopup"
             Placement="Bottom"
             PlacementTarget="{Binding ElementName=SuggestToggle}"
             IsLightDismissEnabled="True"
             IsOpen="{Binding IsSuggestOpen, Mode=TwoWay}">
        <Border Background="White"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                MinWidth="160"
                MaxHeight="240">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button HorizontalContentAlignment="Left"
                          Background="Transparent"
                          Padding="6,3"
                          Content="{Binding Display}"
                          Click="OnSuggestionClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>

    <!-- Cascaded entry source: one closed path field, side-by-side columns in a popup -->
    <views:CascaderView x:Name="Cascader"
                        Grid.Row="0"
                        IsVisible="{Binding IsCascading}" />

    <!-- Multi value: compact summary button with a checkbox popup -->
    <Grid Grid.Row="0"
          IsVisible="{Binding IsMulti}">
      <Grid ColumnDefinitions="*,Auto">
        <ToggleButton Grid.Column="0"
                      x:Name="MultiToggle"
                      HorizontalContentAlignment="Left"
                      IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                      IsEnabled="{Binding IsEditable}"
                      MinHeight="24"
                      Content="{Binding MultiSummary}" />
        <Button Grid.Column="1"
                Width="24"
                MinHeight="24"
                Margin="2,0,0,0"
                Padding="0"
                Content="&#10005;"
                IsEnabled="{Binding IsEditable}"
                IsVisible="{Binding CanClear}"
                Click="OnClearClick" />
      </Grid>
      <Popup IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
             Placement="Bottom"
             PlacementTarget="{Binding ElementName=MultiToggle}"
             IsLightDismissEnabled="True">
        <Border Background="White"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                MaxHeight="260"
                MinWidth="160">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MultiEntries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Margin="8,3"
                            Content="{Binding Display}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
    </Grid>

    <TextBlock Grid.Row="1"
               Margin="0,2,0,0"
               Foreground="#FFC62828"
               TextWrapping="Wrap"
               Text="{Binding Error}"
               IsVisible="{Binding ShowError}" />
  </Grid>
</UserControl>
