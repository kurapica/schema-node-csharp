<UserControl x:Class="SchemaNode.WPF.Man.Views.FunctionDefinitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:view="clr-namespace:SchemaNode.WPF.View;assembly=SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization;assembly=SchemaNode.WPF.View"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <view:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Left: property area of the definition node. return / args / exps under function
             are real Core fields; argument and expression orchestration (including CallArg.Source
             candidate entries) is provided by Core Relation, and the view does no secondary modeling. -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.label.header}"
                           FontSize="14" Margin="0,0,0,8" />

                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.label.namespace}" VerticalAlignment="Center" />
                    <TextBox Width="140" Margin="4,0"
                             Text="{Binding Namespace, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.refresh}" Command="{Binding LoadListCommand}" Margin="4,0" />
                    <ComboBox Width="240" Margin="4,0"
                              ItemsSource="{Binding Functions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedFunction, Mode=TwoWay}" />
                </WrapPanel>

                <WrapPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.label.fullname}" VerticalAlignment="Center" />
                    <TextBox Width="240" Margin="4,0"
                             Text="{Binding FunctionName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.button.new}" Command="{Binding NewCommand}" Margin="4,0" />
                    <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.save}" Command="{Binding SaveCommand}" Margin="4,0" />
                </WrapPanel>

                <TextBlock Text="{Binding Status}" Foreground="Gray"
                           TextWrapping="Wrap" Margin="0,0,0,6" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <view:SchemaView Node="{Binding Editor.Node}" Registry="{Binding Editor.Registry}" />
            </ScrollViewer>
        </DockPanel>

        <!-- Right: test area. Argument inputs create nodes from the parameter types resolved by
             FunctionType; the result creates a node from the return type. -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.label.test}" FontWeight="SemiBold" Margin="0,0,0,6" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.label.args}" Margin="0,0,0,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ArgInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                                            Padding="0,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding TypeName}" Foreground="Gray"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Type resolved: hand the node to SchemaView and let it wrap -->
                                            <view:SchemaView Node="{Binding Node}"
                                                             Visibility="{Binding HasNode,
                                                                          Converter={StaticResource BoolToVisibility}}" />

                                            <!-- Generic or unresolvable type: JSON text -->
                                            <TextBox Margin="0,2,0,0"
                                                     Text="{Binding TextValue, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.tooltip.argjson}"
                                                     Visibility="{Binding HasTextInput,
                                                                  Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <Button Grid.Row="1" Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.button.call}" Command="{Binding CallCommand}"
                        HorizontalAlignment="Left" Margin="0,8" Padding="12,2" />

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.function.label.result}" Margin="0,0,0,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Structured result: node created from the return type, reusing the same rendering -->
                            <view:SchemaView Node="{Binding ResultNode}"
                                             Visibility="{Binding HasResult,
                                                          Converter={StaticResource BoolToVisibility}}" />

                            <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas" Height="120" Margin="0,4,0,0"
                                     Visibility="{Binding HasResultText,
                                                  Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
