<UserControl x:Class="SchemaNode.WPF.Man.Views.AppFieldDefinitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:view="clr-namespace:SchemaNode.WPF.View;assembly=SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization;assembly=SchemaNode.WPF.View"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.appfielddef.button.back}"
                    Command="{Binding BackCommand}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.save}"
                    Command="{Binding SaveCommand}" />
        </WrapPanel>

        <GroupBox Grid.Row="1"
                  Header="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.appfielddef.group.properties}"
                  IsEnabled="{Binding IsEditable}">
            <view:SchemaView Node="{Binding FieldNode}" Registry="{Binding Registry}" />
        </GroupBox>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="DarkSlateGray" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
