<UserControl x:Class="SchemaNode.WPF.Man.Views.TypeDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:SchemaNode.WPF.Man.Views"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization;assembly=SchemaNode.WPF.View"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.typedemo.header}"
                   FontSize="14" Margin="0,0,0,8" />
        <!-- Reuse the generic editor; its DataContext is bound to the Editor property of this VM -->
        <local:SchemaEditorView DataContext="{Binding Editor}" />
    </DockPanel>
</UserControl>
