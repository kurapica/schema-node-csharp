<UserControl x:Class="SchemaNode.WPF.Man.Views.WorkflowStepsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:SchemaNode.WPF.View;assembly=SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization;assembly=SchemaNode.WPF.View">
    <UserControl.Resources>
        <view:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- The workflow steps are a DAG, not tabular data. Show an ordered summary here and let the
         user add/remove steps inline (aligned with workflownodesView.vue in schema-node-man); the
         dedicated workflow canvas still offers graph editing for saved definitions. -->
    <Border Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="4" Padding="10">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Padding="8,2" Margin="8,0,0,0"
                        Command="{Binding AddNodeCommand}"
                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}"
                        Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.workflow.steps.add}" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="8,4" Background="White"
                                BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Type}" Foreground="#667085" Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasPrevious, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Foreground="#8A8F98"
                                                   Text="{Binding DataContext.PreviousLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <TextBlock Text="{Binding PreviousText}" Foreground="#8A8F98" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <Button Padding="4,1" Margin="2,0"
                                            Command="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.workflow.steps.addchild}" />
                                    <Button Padding="4,1" Margin="2,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.workflow.steps.delete}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button HorizontalAlignment="Center" Margin="0,6,0,0" Padding="12,4"
                    Command="{Binding AddNodeCommand}"
                    Visibility="{Binding ShowEmptyAdd, Converter={StaticResource BoolToVisibility}}"
                    Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.workflow.steps.addfirst}" />

            <TextBlock Text="{Binding EmptyText}" Foreground="#8A8F98" Margin="0,4,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Message}" Foreground="#E74C3C" Margin="0,4,0,0"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
