<UserControl x:Class="SchemaNode.WPF.Man.Views.FunctionSchemaView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View;assembly=SchemaNode.WPF.View"
             xmlns:manLoc="clr-namespace:SchemaNode.WPF.View.Localization;assembly=SchemaNode.WPF.View">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <!-- return value -->
            <Border Margin="0,0,0,8"
                    Padding="8"
                    Background="#FFF7F8FA"
                    BorderBrush="#FFD0D5DD"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               Text="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.return}" />
                    <local:SchemaView Node="{Binding ReturnWrapper, ElementName=Root}" />
                </StackPanel>
            </Border>

            <!-- definition arguments: cards + a demo input per argument -->
            <Border Margin="0,0,0,8"
                    Padding="8"
                    Background="#FFF7F8FA"
                    BorderBrush="#FFD0D5DD"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.args}" />
                        <Button HorizontalAlignment="Right"
                                Padding="8,0"
                                Command="{Binding AddArgumentCommand, ElementName=Root}"
                                Content="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.add}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ArgCards, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="#FFDDE1E6"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <local:SchemaView Node="{Binding Arg}" />
                                        <TextBlock Margin="0,6,0,2"
                                                   Foreground="#FF6B7078"
                                                   Text="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.testvalue}" />
                                        <local:SchemaView Node="{Binding DemoNode}" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Padding="8,0"
                                                    Command="{Binding AddCommand}"
                                                    Content="+" />
                                            <Button Margin="4,0,0,0"
                                                    Padding="8,0"
                                                    Command="{Binding RemoveCommand}"
                                                    Content="−" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- expressions: cards with a live result preview -->
            <Border Margin="0,0,0,8"
                    Padding="8"
                    Background="#FFF7F8FA"
                    BorderBrush="#FFD0D5DD"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.exps}" />
                        <Button HorizontalAlignment="Right"
                                Padding="8,0"
                                Command="{Binding AddExpressionCommand, ElementName=Root}"
                                Content="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.add}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ExpCards, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="#FFDDE1E6"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <local:SchemaView Node="{Binding Exp}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Margin="0,0,6,0"
                                                       Foreground="#FF6B7078"
                                                       VerticalAlignment="Top"
                                                       Text="{Binding Source={x:Static manLoc:LocaleManager.Instance}, Path=Version, Converter={x:Static manLoc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.man.function.result}" />
                                            <TextBox Grid.Column="1"
                                                     IsReadOnly="True"
                                                     Text="{Binding Preview, Mode=OneWay}"
                                                     TextWrapping="Wrap" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Padding="8,0"
                                                    Command="{Binding AddCommand}"
                                                    Content="+" />
                                            <Button Margin="4,0,0,0"
                                                    Padding="8,0"
                                                    Command="{Binding RemoveCommand}"
                                                    Content="−" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- any other fields the function struct carries -->
            <ItemsControl ItemsSource="{Binding Others, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SchemaView Node="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
