<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="using:SchemaNode.Avalonia.View"
        xmlns:appviews="using:SchemaNode.Avalonia.AppView.Views"
        x:Class="SchemaNode.Avalonia.Test.MainWindow"
        x:CompileBindings="False"
        Background="White"
        Title="SchemaNode harness" Height="720" Width="1000">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
      <TextBlock Text="Case" VerticalAlignment="Center" />
      <ComboBox Width="260" VerticalAlignment="Center"
                ItemsSource="{Binding Cases}"
                SelectedItem="{Binding SelectedCase, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <CheckBox Content="Form arrays" VerticalAlignment="Center"
                IsChecked="{Binding FormArrays, Mode=TwoWay}"
                IsEnabled="{Binding SelectedCase.TableCapable}" />
      <TextBlock Text="Locale" VerticalAlignment="Center" Margin="8,0,0,0" />
      <ComboBox Width="90" VerticalAlignment="Center"
                ItemsSource="{Binding Locales}"
                SelectedItem="{Binding SelectedLocale, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Code}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap"
               Margin="0,0,0,8" />

    <!-- Regular cases: one bare node through the schema view, registry-driven. -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                  IsVisible="{Binding ShowSchemaView}">
      <view:SchemaView Node="{Binding Node}" Registry="{Binding Registry}" />
    </ScrollViewer>

    <!-- The pageable case hosts the App-layer page table so page state can be asserted. -->
    <DockPanel Grid.Row="2" IsVisible="{Binding ShowPageTable}">
      <Border DockPanel.Dock="Top" Background="#F5F7FA" Padding="8,4" Margin="0,0,0,6">
        <TextBlock Text="Pageable: total / pages / navigation / cell edit / delete + resume are asserted on load."
                   Foreground="Gray" TextWrapping="Wrap" />
      </Border>
      <appviews:PageTableView DataContext="{Binding PageTable}" />
    </DockPanel>

    <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
               Text="{Binding NodeValue}" />
  </Grid>
</Window>
