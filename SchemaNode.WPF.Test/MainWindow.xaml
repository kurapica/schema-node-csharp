<Window x:Class="SchemaNode.WPF.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:SchemaNode.WPF.View;assembly=SchemaNode.WPF.View"
        Title="SchemaNode harness" Height="720" Width="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Case" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="260" VerticalAlignment="Center"
                      ItemsSource="{Binding Cases}"
                      SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                      DisplayMemberPath="Title" />
            <CheckBox Content="Form arrays" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding FormArrays, Mode=TwoWay}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="Gray" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <view:SchemaView Node="{Binding Node}"
                             Registry="{Binding Registry}" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="{Binding NodeValue}" />
    </Grid>
</Window>
