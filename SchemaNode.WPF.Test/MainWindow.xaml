<Window x:Class="SchemaNode.WPF.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:SchemaNode.WPF.View;assembly=SchemaNode.WPF.View"
        xmlns:appviews="clr-namespace:SchemaNode.WPF.AppView.Views;assembly=SchemaNode.WPF.AppView"
        Title="SchemaNode harness" Height="720" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Case" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="260" VerticalAlignment="Center"
                      ItemsSource="{Binding Cases}"
                      SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                      DisplayMemberPath="Title" />
            <CheckBox Content="Form arrays" VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding FormArrays, Mode=TwoWay}" />
            <TextBlock Text="Locale" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox Width="90" VerticalAlignment="Center"
                      ItemsSource="{Binding Locales}"
                      SelectedItem="{Binding SelectedLocale, Mode=TwoWay}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="Gray" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Regular cases: one bare node through the schema view, registry-driven. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowSchemaView, Converter={StaticResource BoolVisibility}}">
            <view:SchemaView Node="{Binding Node}"
                             Registry="{Binding Registry}" />
        </ScrollViewer>

        <!-- The pageable case hosts the App-layer page table so page state can be asserted. -->
        <DockPanel Grid.Row="1"
                   Visibility="{Binding ShowPageTable, Converter={StaticResource BoolVisibility}}">
            <Border DockPanel.Dock="Top" Background="#F5F7FA" Padding="8,4" Margin="0,0,0,6">
                <TextBlock Text="Pageable: total / pages / navigation / cell edit / delete + resume are asserted on load."
                           Foreground="Gray" TextWrapping="Wrap" />
            </Border>
            <appviews:PageTableView DataContext="{Binding PageTable}" />
        </DockPanel>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="{Binding NodeValue}" />
    </Grid>
</Window>
