                <ResourceDictionary Source="/SchemaNode.WPF.AppView;component/Templates/PageTableTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
