using System.Linq.Expressions;
using System.Reflection;
using SchemaNode.Enum;
using SchemaNode.Utility;

namespace SchemaNode.Components;

internal sealed class AppSchemaDataFilterVisitor : ExpressionVisitor{
 readonly Stack<AppSchemaDataFilter> _stack = new();
 string? _paramName;

 public AppSchemaDataFilter? Result => _stack.Count >0 ? _stack.Peek() : null;

 public static AppSchemaDataFilter? Parse(LambdaExpression expression)
 {
 var visitor = new AppSchemaDataFilterVisitor();
 visitor.Visit(expression);
 return visitor.Result;
 }

 protected override Expression VisitLambda<T>(Expression<T> node)
 {
 _paramName = node.Parameters.FirstOrDefault()?.Name;
 return base.VisitLambda(node);
 }

 protected override Expression VisitParameter(ParameterExpression node)
 {
 if (_paramName != null && node.Name != _paramName)
 throw new NotSupportedException($"[VisitParameter]{node}");
 return base.VisitParameter(node);
 }

 protected override Expression VisitConstant(ConstantExpression node)
 {
 _stack.Push(new AppSchemaDataFilterValue(node.Value!));
 return base.VisitConstant(node);
 }

 protected override Expression VisitMember(MemberExpression node)
 {
 if (IsParameterMember(node))
 {
 var fieldName = node.Member.Name.ToCamelCase();
 _stack.Push(new AppSchemaDataFilterField(fieldName));
 return node;
 }

 var value = TryEvaluate(node).Value;
 _stack.Push(new AppSchemaDataFilterValue(value!));
 return node;
 }

 protected override Expression VisitUnary(UnaryExpression node)
 {
 if (node.NodeType == ExpressionType.Convert || node.NodeType == ExpressionType.ConvertChecked)
 {
 return base.Visit(node.Operand);
 }

 if (node.NodeType == ExpressionType.Not)
 {
 base.Visit(node.Operand);
 var operand = _stack.Pop();
 if (operand is AppSchemaDataFilterValue v && v.Value is bool b)
 {
 _stack.Push(new AppSchemaDataFilterValue(!b));
 return node;
 }
 }

 throw new NotSupportedException($"[VisitUnary]{node}");
 }

 protected override Expression VisitBinary(BinaryExpression node)
 {
 base.VisitBinary(node);

 var right = _stack.Pop();
 var left = _stack.Pop();

 switch (node.NodeType)
 {
 case ExpressionType.AndAlso:
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.AndAlso, left, right));
 return node;
 case ExpressionType.OrElse:
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.OrElse, left, right));
 return node;
 case ExpressionType.Equal:
 case ExpressionType.NotEqual:
 case ExpressionType.GreaterThan:
 case ExpressionType.GreaterThanOrEqual:
 case ExpressionType.LessThan:
 case ExpressionType.LessThanOrEqual:
 _stack.Push(BuildCompare(node.NodeType, left, right));
 return node;
 default:
 throw new NotSupportedException($"[VisitBinary]{node}");
 }
 }

 protected override Expression VisitMethodCall(MethodCallExpression node)
 {
 if (node.Method.Name == nameof(string.Contains) && node.Object != null && node.Arguments.Count ==1)
 {
 Visit(node.Object);
 Visit(node.Arguments[0]);
 var value = _stack.Pop();
 var field = _stack.Pop();
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.Match, field, value));
 return node;
 }

 if (node.Method.Name == nameof(string.StartsWith) && node.Object != null && node.Arguments.Count ==1)
 {
 Visit(node.Object);
 Visit(node.Arguments[0]);
 var value = _stack.Pop();
 var field = _stack.Pop();
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.StartsWith, field, value));
 return node;
 }

 if (node.Method.Name == nameof(string.EndsWith) && node.Object != null && node.Arguments.Count ==1)
 {
 Visit(node.Object);
 Visit(node.Arguments[0]);
 var value = _stack.Pop();
 var field = _stack.Pop();
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.EndsWith, field, value));
 return node;
 }

 if (node.Method.Name == nameof(Enumerable.Contains) && node.Arguments.Count ==2)
 {
 Visit(node.Arguments[0]);
 Visit(node.Arguments[1]);
 var field = _stack.Pop();
 var values = _stack.Pop();
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.Contains, values, field));
 return node;
 }

 if (node.Method.Name == nameof(ICollection.Contains) && node.Object != null && node.Arguments.Count ==1)
 {
 Visit(node.Object);
 Visit(node.Arguments[0]);
 var field = _stack.Pop();
 var values = _stack.Pop();
 _stack.Push(new AppSchemaDataFilterBinary(LogicType.Contains, values, field));
 return node;
 }

 throw new NotSupportedException($"[VisitMethodCall]{node}");
 }

 static AppSchemaDataFilter BuildCompare(ExpressionType type, AppSchemaDataFilter left, AppSchemaDataFilter right)
 {
 if (type == ExpressionType.Equal || type == ExpressionType.NotEqual)
 {
 if (TryGetNullCompare(left, right, out var unary))
 return unary!;
 }

 return new AppSchemaDataFilterBinary(MapLogicType(type), left, right);
 }

 static bool TryGetNullCompare(AppSchemaDataFilter left, AppSchemaDataFilter right, out AppSchemaDataFilter? unary)
 {
 unary = null;

 if (left is AppSchemaDataFilterField lField && right is AppSchemaDataFilterValue rVal && rVal.Value == null)
 {
 unary = new AppSchemaDataFilterUnary(LogicType.IsNull, lField);
 return true;
 }

 if (right is AppSchemaDataFilterField rField && left is AppSchemaDataFilterValue lVal && lVal.Value == null)
 {
 unary = new AppSchemaDataFilterUnary(LogicType.IsNull, rField);
 return true;
 }

 return false;
 }

 static LogicType MapLogicType(ExpressionType type) =>
 type switch {
 ExpressionType.Equal => LogicType.Equal,
 ExpressionType.NotEqual => LogicType.NotEqual,
 ExpressionType.GreaterThan => LogicType.GreaterThan,
 ExpressionType.GreaterThanOrEqual => LogicType.GreaterEqual,
 ExpressionType.LessThan => LogicType.LessThan,
 ExpressionType.LessThanOrEqual => LogicType.LessEqual,
 _ => throw new NotSupportedException($"[MapLogicType]{type}")
 };

 static bool IsParameterMember(MemberExpression node)
 => node.Expression is ParameterExpression;

 static ConstantExpression TryEvaluate(Expression expression)
 {
 if (expression.NodeType == ExpressionType.Constant)
 return (ConstantExpression)expression;

 if (expression.NodeType == ExpressionType.MemberAccess)
 return GetMemberConstant((MemberExpression)expression);

 throw new NotSupportedException();
 }

 static ConstantExpression GetMemberConstant(MemberExpression node)
 {
 object? value;
 if (node.Member.MemberType == MemberTypes.Field)
 value = GetFieldValue(node);
 else if (node.Member.MemberType == MemberTypes.Property)
 value = GetPropertyValue(node);
 else throw new NotSupportedException();

 return Expression.Constant(value, node.Type);
 }

 static object? GetFieldValue(MemberExpression node)
 {
 var fieldInfo = (FieldInfo)node.Member;
 var instance = node.Expression == null ? null : TryEvaluate(node.Expression).Value;
 return fieldInfo.GetValue(instance);
 }

 static object? GetPropertyValue(MemberExpression node)
 {
 var propertyInfo = (PropertyInfo)node.Member;
 var instance = node.Expression == null ? null : TryEvaluate(node.Expression).Value;
 return propertyInfo.GetValue(instance, null);
 }
}
