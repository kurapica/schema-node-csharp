<UserControl x:Class="SchemaNode.WPF.View.Views.FlagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             MinHeight="24"
             ToolTip="{Binding Error}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Flags enum: the node value is a set, so the editor is a check-list, not a text box. -->
        <Grid Grid.Row="0">
            <ToggleButton x:Name="MultiToggle"
                          HorizontalContentAlignment="Left"
                          IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                          IsEnabled="{Binding IsEditable}"
                          MinHeight="24"
                          Content="{Binding MultiSummary}" />
            <Popup IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MultiToggle}"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="White"
                        BorderBrush="#FFB0B0B0"
                        BorderThickness="1"
                        MaxHeight="260"
                        MinWidth="{Binding ActualWidth, ElementName=MultiToggle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding MultiEntries}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="8,3"
                                              Content="{Binding Display}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />
    </Grid>
</UserControl>
