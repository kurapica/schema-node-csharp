<Window x:Class="SchemaNode.WPF.View.Views.TableRowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SchemaNode.WPF.View"
        xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization"
        Title="Row editor"
        Width="480"
        Height="380"
        MinWidth="360"
        MinHeight="240"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <local:SchemaView x:Name="RowView" Role="RowEditor" />
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Padding="10,3"
                    MinHeight="26"
                    IsDefault="True"
                    Click="OnConfirm"
                    Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.ok}" />
            <Button Padding="10,3"
                    MinHeight="26"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.cancel}" />
        </StackPanel>
    </Grid>
</Window>
