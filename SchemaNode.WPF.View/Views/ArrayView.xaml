<UserControl x:Class="SchemaNode.WPF.View.Views.ArrayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization"
             ToolTip="{Binding Error}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,4">
            <Button Padding="8,2"
                    MinHeight="24"
                    Command="{Binding AddCommand}"
                    Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.addrow}" />
            <Button Padding="8,2"
                    MinHeight="24"
                    Margin="6,0,0,0"
                    Command="{Binding RemoveLastCommand}"
                    Content="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.button.remove}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />

        <ScrollViewer MaxHeight="360"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <ItemsControl ItemsSource="{Binding Children}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1"
                              Visibility="{Binding IsVisible, Converter={x:Static local:Converters.BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <local:SchemaView Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              Node="{Binding}" />

                            <Button Grid.Column="1"
                                    Width="26"
                                    Height="24"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding RemoveCommand}"
                                    Content="−" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
