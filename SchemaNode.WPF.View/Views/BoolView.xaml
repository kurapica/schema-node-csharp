<UserControl x:Class="SchemaNode.WPF.View.Views.BoolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization"
             MinHeight="24"
             ToolTip="{Binding Error}">
    <StackPanel>
        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  IsEnabled="{Binding IsEditable}"
                  MinHeight="24" />
        <TextBlock Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />
    </StackPanel>
</UserControl>
