<UserControl x:Class="SchemaNode.WPF.View.Views.InputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization"
             MinHeight="24"
             ToolTip="{Binding Error}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Plain text: no entries at all -->
        <TextBox Grid.Row="0"
                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 IsEnabled="{Binding IsEditable}"
                 IsReadOnly="{Binding IsEditable, Converter={x:Static local:Converters.Not}}"
                 Visibility="{Binding IsPlainText, Converter={x:Static local:Converters.BoolToVisibility}}"
                 MinHeight="24" />

        <!-- Single level entry source: compact closed drop-down, virtualized popup -->
        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  DisplayMemberPath="Display"
                  IsEditable="{Binding AsSuggest}"
                  IsEnabled="{Binding IsEditable}"
                  MaxDropDownHeight="240"
                  MinHeight="24"
                  Visibility="{Binding IsDropDown, Converter={x:Static local:Converters.BoolToVisibility}}">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>

        <!-- Cascaded entry source: one compact drop-down per level, next level appears on selection -->
        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding Levels}"
                      Visibility="{Binding IsCascading, Converter={x:Static local:Converters.BoolToVisibility}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ComboBox Width="150"
                              Margin="0,0,6,0"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              MaxDropDownHeight="240"
                              MinHeight="24">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Multi value: compact summary button with a virtualized checkbox popup -->
        <Grid Grid.Row="0"
              Visibility="{Binding IsMulti, Converter={x:Static local:Converters.BoolToVisibility}}">
            <ToggleButton x:Name="MultiToggle"
                          HorizontalContentAlignment="Left"
                          IsChecked="{Binding IsPopupOpen, Mode=TwoWay}"
                          IsEnabled="{Binding IsEditable}"
                          MinHeight="24"
                          Content="{Binding MultiSummary}" />
            <Popup IsOpen="{Binding IsPopupOpen, Mode=TwoWay}"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=MultiToggle}"
                   StaysOpen="False"
                   AllowsTransparency="True">
                <Border Background="White"
                        BorderBrush="#FFB0B0B0"
                        BorderThickness="1"
                        MaxHeight="260"
                        MinWidth="{Binding ActualWidth, ElementName=MultiToggle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding MultiEntries}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="8,3"
                                              Content="{Binding Display}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />
    </Grid>
</UserControl>
