<UserControl x:Class="SchemaNode.WPF.View.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             xmlns:views="clr-namespace:SchemaNode.WPF.View.Views"
             ToolTip="{Binding Error}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Group header row; only present when at least one struct or struct-array column exists. -->
            <ScrollViewer Grid.Row="0"
                          x:Name="TopHeaderScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasGroupHeaders, Converter={x:Static local:Converters.BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding TopHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}"
                                    Height="26"
                                    Padding="6,0"
                                    Background="#FFE4E4E4"
                                    BorderBrush="#FFD0D0D0"
                                    BorderThickness="1,0,1,1">
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Label}"
                                           Text="{Binding Label}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Leaf header row. The operations header carries the add-row link. -->
            <ScrollViewer Grid.Row="1"
                          x:Name="HeaderScroll"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LeafHeaders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}"
                                    Height="28"
                                    Padding="6,0"
                                    Background="#FFF0F0F0"
                                    BorderBrush="#FFD0D0D0"
                                    BorderThickness="0,0,1,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Label}"
                                               Text="{Binding Label}" />
                                    <Button Margin="4,0,0,0"
                                            Padding="4,0"
                                            MinHeight="18"
                                            FontSize="11"
                                            Content="{Binding CommandText}"
                                            Command="{Binding Command}"
                                            Visibility="{Binding HasCommand, Converter={x:Static local:Converters.BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- One virtualized item per array element; TableRowGroupView merges non-array cells
                 by rowspan across the element's visual rows. -->
            <ScrollViewer Grid.Row="2"
                          x:Name="BodyScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="True"
                          ScrollChanged="OnBodyScrollChanged">
                <ItemsControl ItemsSource="{Binding RowGroups}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TableRowGroupView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
