<UserControl x:Class="SchemaNode.WPF.View.Views.CascaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             MinHeight="24"
             Unloaded="OnViewUnloaded"
             ToolTip="{Binding Error}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- One closed field showing the whole selected path. -->
        <Button x:Name="Field"
                Grid.Column="0"
                MinHeight="24"
                Padding="6,0"
                HorizontalContentAlignment="Left"
                IsEnabled="{Binding IsEditable}"
                Content="{Binding CascadeSummary}"
                PreviewKeyDown="OnFieldPreviewKeyDown"
                PreviewMouseLeftButtonDown="OnFieldPreviewMouseDown"
                Click="OnFieldClick">
            <Button.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Button.ContentTemplate>
        </Button>

        <Button x:Name="ClearButton"
                Grid.Column="1"
                Width="22"
                MinHeight="24"
                Margin="2,0,0,0"
                Padding="0"
                Content="&#215;"
                IsEnabled="{Binding IsEditable}"
                Visibility="{Binding CanClear, Converter={x:Static local:Converters.BoolToVisibility}}"
                Click="OnClearClick" />

        <!-- Side-by-side columns, one per level; the popup is its own window, so a grid cell
             never clips it and the cell itself keeps its fixed width. -->
        <Popup x:Name="Panel"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Field}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White"
                    BorderBrush="#FFB0B0B0"
                    BorderThickness="1"
                    MaxHeight="320"
                    PreviewKeyDown="OnPanelPreviewKeyDown">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Levels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180"
                                        BorderBrush="#FFE4E4E4"
                                        BorderThickness="0,0,1,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ListBox BorderThickness="0"
                                                 Padding="0"
                                                 MaxHeight="300"
                                                 ItemsSource="{Binding Entries}"
                                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                 SelectionChanged="OnColumnSelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <!-- Let the row content reach the column's right edge so
                                                     the expander arrow can sit there. -->
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="4,2"
                                                                   Text="{Binding Display}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Display}" />
                                                        <!-- Expandable rows only; Collapsed takes no width, so
                                                             leaves keep the full row for their text. It is not
                                                             hit-testable, so a click on it is the row's click. -->
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="0,2,4,2"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="Gray"
                                                                   Text="&gt;"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="{Binding HasChildren, Converter={x:Static local:Converters.BoolToVisibility}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
