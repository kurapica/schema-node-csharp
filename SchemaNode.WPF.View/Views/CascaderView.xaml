<UserControl x:Class="SchemaNode.WPF.View.Views.CascaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization"
             MinHeight="24"
             Unloaded="OnViewUnloaded"
             ToolTip="{Binding Error}">
    <UserControl.Resources>
        <!-- Flat row buttons: the entry row is split into a label area (commit) and, for parents,
             an arrow area (expand only). The template removes the button chrome so both areas read
             as parts of the row while keeping their own hit areas. -->
        <Style x:Key="CascaderRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The expander gets a fixed, comfortably large hit area so it never depends on the text
             width of the glyph. -->
        <Style x:Key="CascaderExpandButton" TargetType="Button" BasedOn="{StaticResource CascaderRowButton}">
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="Gray" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEDEDED" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- One closed field showing the whole selected path. -->
        <Button x:Name="Field"
                Grid.Column="0"
                MinHeight="24"
                Padding="6,0"
                HorizontalContentAlignment="Left"
                IsEnabled="{Binding IsEditable}"
                Content="{Binding CascadeSummary}"
                PreviewKeyDown="OnFieldPreviewKeyDown"
                PreviewMouseLeftButtonDown="OnFieldPreviewMouseDown"
                Click="OnFieldClick">
            <Button.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </Button.ContentTemplate>
        </Button>

        <Button x:Name="ClearButton"
                Grid.Column="1"
                Width="22"
                MinHeight="24"
                Margin="2,0,0,0"
                Padding="0"
                Content="&#215;"
                IsEnabled="{Binding IsEditable}"
                Visibility="{Binding CanClear, Converter={x:Static local:Converters.BoolToVisibility}}"
                Click="OnClearClick" />

        <!-- Side-by-side columns, one per level; the popup is its own window, so a grid cell
             never clips it and the cell itself keeps its fixed width. -->
        <Popup x:Name="Panel"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=Field}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White"
                    BorderBrush="#FFB0B0B0"
                    BorderThickness="1"
                    MinWidth="180"
                    MaxHeight="320"
                    PreviewKeyDown="OnPanelPreviewKeyDown">
                <Grid>
                    <!-- The level columns, shown as soon as a snapshot with candidates is applied. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ShowCascadeLoading, Converter={x:Static local:Converters.InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Levels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180"
                                        BorderBrush="#FFE4E4E4"
                                        BorderThickness="0,0,1,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <!-- The selection is owned by the wrapper (it also reloads the
                                             level tree from the node value), so the list only displays
                                             it and row clicks are handled by the two buttons below. -->
                                        <ListBox BorderThickness="0"
                                                 Padding="0"
                                                 MaxHeight="300"
                                                 ItemsSource="{Binding Entries}"
                                                 SelectedItem="{Binding Selected, Mode=OneWay}">
                                            <ListBox.ItemContainerStyle>
                                                <!-- Let the row content reach the column's right edge so
                                                     the expander arrow can sit there. -->
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Label area: selects the entry itself. A disabled
                                                             entry cannot be committed. -->
                                                        <Button Grid.Column="0"
                                                                Style="{StaticResource CascaderRowButton}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                Click="OnItemSelectClick">
                                                            <TextBlock Margin="4,2"
                                                                       Text="{Binding Display}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Display}" />
                                                        </Button>

                                                        <!-- Arrow area: expands the next level only and never
                                                             commits; Collapsed takes no width, so leaves
                                                             keep the full row. -->
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource CascaderExpandButton}"
                                                                Content="&gt;"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                Visibility="{Binding HasChildren, Converter={x:Static local:Converters.BoolToVisibility}}"
                                                                Click="OnItemExpandClick" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!-- Placeholder for the window between opening and the first applied snapshot:
                         the popup is visible and explains why the columns are not there yet. -->
                    <TextBlock Margin="12,8"
                               Foreground="Gray"
                               Text="{Binding Source={x:Static loc:LocaleManager.Instance}, Path=Version, Converter={x:Static loc:LocalizedTextConverter.Instance}, ConverterParameter=wpf.page.loading}"
                               Visibility="{Binding ShowCascadeLoading, Converter={x:Static local:Converters.BoolToVisibility}}" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
