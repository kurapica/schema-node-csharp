<UserControl x:Class="SchemaNode.WPF.View.Views.YearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             MinHeight="24"
             ToolTip="{Binding Error}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Free year: an ordinary integer editor; Core's Int constraints still validate it. -->
        <TextBox Grid.Row="0"
                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 IsEnabled="{Binding IsEditable}"
                 IsReadOnly="{Binding IsEditable, Converter={x:Static local:Converters.Not}}"
                 MinHeight="24"
                 Visibility="{Binding UseWhiteList, Converter={x:Static local:Converters.InverseBoolToVisibility}}" />

        <!-- White-listed years are a closed choice, so a drop-down replaces the free editor. -->
        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding WhiteListYears}"
                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                  IsEnabled="{Binding IsEditable}"
                  MaxDropDownHeight="240"
                  MinHeight="24"
                  Visibility="{Binding UseWhiteList, Converter={x:Static local:Converters.BoolToVisibility}}" />

        <TextBlock Grid.Row="1"
                   Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />
    </Grid>
</UserControl>
