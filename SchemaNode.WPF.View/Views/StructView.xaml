<UserControl x:Class="SchemaNode.WPF.View.Views.StructView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             ToolTip="{Binding Error}">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Children}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2"
                          Visibility="{Binding IsVisible, Converter={x:Static local:Converters.BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Label}"
                                   Text="{Binding Label}" />

                        <local:SchemaView Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          Node="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />
    </StackPanel>
</UserControl>
