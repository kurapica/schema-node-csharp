<UserControl x:Class="SchemaNode.WPF.View.Views.LocaleStringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SchemaNode.WPF.View"
             xmlns:loc="clr-namespace:SchemaNode.WPF.View.Localization"
             MinHeight="24"
             ToolTip="{Binding Error}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Only the default key stays on the form; translations live behind the entry button. -->
            <TextBox Grid.Column="0"
                     Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     IsReadOnly="{Binding IsEditable, Converter={x:Static local:Converters.Not}}"
                     MinHeight="24" />

            <Button Grid.Column="1"
                    Margin="4,0,0,0"
                    MinHeight="24"
                    Padding="8,0"
                    Click="OnShowTranslations"
                    ToolTip="{Binding Summary}">
                <TextBlock Text="{Binding Summary}"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis" />
            </Button>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,2,0,0"
                   Foreground="#FFC62828"
                   TextWrapping="Wrap"
                   Text="{Binding Error}"
                   Visibility="{Binding ShowError, Converter={x:Static local:Converters.BoolToVisibility}}" />
    </Grid>
</UserControl>
