<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SchemaNode.WPF.View.Views">

    <!-- Every editor keeps vue's 120px input minimum so a short value (e.g. a cascade showing
         only "system") never collapses to an unusably small field. -->
    <DataTemplate x:Key="SchemaInput">
        <views:InputView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaBoolean">
        <views:BoolView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaDate">
        <views:DateView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaStruct">
        <views:StructView />
    </DataTemplate>

    <DataTemplate x:Key="SchemaArray">
        <views:ArrayView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaTable">
        <views:TableView />
    </DataTemplate>

    <!-- Namespace / type path with generic arguments (counterpart of namespace.vue). -->
    <DataTemplate x:Key="SchemaTypeSelector">
        <views:TypeSelectorView MinWidth="120" />
    </DataTemplate>

    <!-- Type-driven views mirrored from schema-node-vue-view (flagEnumView / yearView /
         rangeDateView / localeStringView). Registered by type in SchemaViewRegistry. -->
    <DataTemplate x:Key="SchemaFlags">
        <views:FlagsView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaYear">
        <views:YearView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaLanguage">
        <views:LanguageView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaRangeDate">
        <views:RangeDateView MinWidth="120" />
    </DataTemplate>

    <DataTemplate x:Key="SchemaLocaleString">
        <views:LocaleStringView MinWidth="120" />
    </DataTemplate>

    <!-- Last-resort read-only rendering for node shapes without a dedicated view. -->
    <DataTemplate x:Key="SchemaFallback">
        <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True"
                 ToolTip="{Binding TypeName}" BorderThickness="0" Background="Transparent" />
    </DataTemplate>
</ResourceDictionary>
