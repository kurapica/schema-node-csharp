<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SchemaNode.WPF.View.Views">

    <DataTemplate x:Key="SchemaInput">
        <views:InputView />
    </DataTemplate>

    <DataTemplate x:Key="SchemaBoolean">
        <views:BoolView />
    </DataTemplate>

    <DataTemplate x:Key="SchemaDate">
        <views:DateView />
    </DataTemplate>

    <DataTemplate x:Key="SchemaStruct">
        <views:StructView />
    </DataTemplate>

    <DataTemplate x:Key="SchemaArray">
        <views:ArrayView />
    </DataTemplate>

    <DataTemplate x:Key="SchemaTable">
        <views:TableView />
    </DataTemplate>

    <!-- Last-resort read-only rendering for node shapes without a dedicated view. -->
    <DataTemplate x:Key="SchemaFallback">
        <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True"
                 ToolTip="{Binding TypeName}" BorderThickness="0" Background="Transparent" />
    </DataTemplate>
</ResourceDictionary>
