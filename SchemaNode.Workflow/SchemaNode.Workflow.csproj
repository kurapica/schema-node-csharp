<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <RootNamespace>SchemaNode</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchemaNode.Core\SchemaNode.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Quartz" Version="4.6.2" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="TimeZoneConverter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="locale\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SchemaNode.App" />
    <InternalsVisibleTo Include="SchemaNode.AI" />
    <InternalsVisibleTo Include="SchemaNode.UnitTest" />
    <InternalsVisibleTo Include="SchemaNode.WPF.Man" />
    <InternalsVisibleTo Include="SchemaNode.Avalonia.Man" />
  </ItemGroup>

</Project>
