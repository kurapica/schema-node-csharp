<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SchemaNode.Example</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DocumentationFile>bin\Debug\SchemaNode.Example.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DocumentationFile>bin\Release\SchemaNode.Example.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cszy.DistributedLock.Medallion" Version="0.0.240" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Npgsql.Json.NET" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchemaNode.Kafka\SchemaNode.Kafka.csproj" />
    <ProjectReference Include="..\SchemaNode.McpHost\SchemaNode.McpHost.csproj" />
    <ProjectReference Include="..\SchemaNode.MySql\SchemaNode.MySql.csproj" />
    <ProjectReference Include="..\SchemaNode.Ontology\SchemaNode.Ontology.csproj" />
    <ProjectReference Include="..\SchemaNode.PostgreSQL\SchemaNode.PostgreSQL.csproj" />
    <ProjectReference Include="..\SchemaNode.Vector\SchemaNode.Vector.csproj" />
    <ProjectReference Include="..\SchemaNode\SchemaNode.csproj" />
  </ItemGroup>
</Project>
