{
  "Name": "IDCard.CN",
  "State": "app.idCardCnState",
  "Steps": [
    {
      "Name": "Region",
      "Type": "Charset",
      "Set": "0-9",
      "Min": 6,
      "Max": 6
    },
    { "Type": "Literal", "Text": "" },
    {
      "Name": "Birth",
      "Type": "Group",
      "Steps": [
        { "Name": "Year", "Type": "Charset", "Set": "0-9", "Min": 4, "Max": 4 },
        { "Name": "Month", "Type": "Charset", "Set": "0-9", "Min": 2, "Max": 2 },
        { "Name": "Day", "Type": "Charset", "Set": "0-9", "Min": 2, "Max": 2 }
      ]
    },
    { "Type": "Literal", "Text": "" },
    {
      "Name": "Seq",
      "Type": "Charset",
      "Set": "0-9",
      "Min": 3,
      "Max": 3
    },
    { "Type": "Literal", "Text": "" },
    {
      "Name": "Check",
      "Type": "Branch",
      "Nexts": [
        { "Type": "Charset", "Set": "0-9", "Min": 1, "Max": 1 },
        { "Type": "Literal", "Text": "X" }
      ]
    },
    {
      "Name": "Verify",
      "Type": "Function",
      "Func": "app.idcard.verify",
      "Args": [
        { "Name": "_text" },
        { "Name": "Region" },
        { "Name": "BirthYear" },
        { "Name": "BirthMonth" },
        { "Name": "BirthDay" },
        { "Name": "Seq" },
        { "Name": "Check" }
      ]
    }
  ],
  "Additional": {
    "regionFields": ["Province", "City", "District"],
    "regionNote": "Map Region(6) by external code table to Province/City/District in State",
    "checkNote": "Check digit validation can be done by function in runtime"
  }
}
