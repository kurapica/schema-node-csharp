<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>1.0.1</Version>
		<Authors>kurapica125@outlook.com</Authors>
		<Description>Executable Structured Semantic Language</Description>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/kurapica/schema-node-csharp</RepositoryUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageTags>SchemaNode;Semantic;Schema;DSL</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SchemaNode</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="TimeZoneConverter" Version="8.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="SchemaNode.App" />
    <InternalsVisibleTo Include="SchemaNode.UnitTest" />
    <InternalsVisibleTo Include="SchemaNode.WPF.View" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="locale\*.json" />
  </ItemGroup>
	
	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>
